datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  type        String    // CategoryType — configurable, not hardcoded
  description String?
  parentId    String?
  icon        String?
  color       String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  topics      Topic[]
}

model Tag {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  color     String     @default("#D97706")
  count     Int        @default(0)
  createdAt DateTime   @default(now())
  topicTags TopicTag[] // Research Storage v1: normalized tag relation
}

model Topic {
  id            String          @id @default(uuid())
  title         String
  slug          String          @unique
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  type          String          // CategoryType — configurable, not hardcoded
  parentId      String?
  description   String          @default("")
  content       String          @default("")
  tags          String[]        @default([]) // Kept as denormalized cache for backward compat
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  notes         Note[]
  resources     Resource[]
  studyProgress StudyProgress?
  sourceLinks   KnowledgeLink[] @relation("SourceLinks")
  targetLinks   KnowledgeLink[] @relation("TargetLinks")
  // Research Storage v1: additive relations
  noteLinks     NoteTopicLink[] // multi-topic notes
  topicTags     TopicTag[]      // normalized tag relation
  snapshots     KnowledgeProgressSnapshot[] // append-only progress history
}

model Note {
  id         String   @id @default(uuid())
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title      String
  content    String
  sourcePath String?  // nullable — matches Note.sourcePath in types/index.ts
  type       String   @default("insight") // 'study' | 'insight' | 'question' | 'summary'
  isPrivate  Boolean  @default(false)
  tags       String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Research Storage v1: additive multi-topic relation
  additionalTopics NoteTopicLink[]
}

model Resource {
  id        String   @id @default(uuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title     String
  type      String   @default("book") // 'book' | 'article' | 'video' | 'audio' | 'pdf' | 'link'
  author    String?
  url       String?
  filePath  String?
  notes     String?
  createdAt DateTime @default(now())
}

model KnowledgeLink {
  id          String   @id @default(uuid())
  sourceId    String
  source      Topic    @relation("SourceLinks", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId    String
  target      Topic    @relation("TargetLinks", fields: [targetId], references: [id], onDelete: Cascade)
  linkType    String   @default("related") // 'related' | 'prerequisite' | 'advanced' | 'contradicts'
  strength    Int      @default(3)
  notes       String?
  explanation String?
  createdAt   DateTime @default(now())
}

model StudyProgress {
  id          String    @id @default(uuid())
  topicId     String    @unique
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status      String    @default("not_started") // 'not_started' | 'in_progress' | 'completed' | 'reviewing'
  progress    Float     @default(0)
  startDate   DateTime?
  endDate     DateTime?
  lastStudied DateTime?
  nextReview  DateTime?
  interval    Int       @default(0)
  easeFactor  Float     @default(2.5)
  repetitions Int       @default(0)
  totalNotes  Int       @default(0)
  timeSpent   Int       @default(0)
  updatedAt   DateTime  @updatedAt
}

model SyncSession {
  id              String   @id @default(uuid())
  clientSyncId    String   @unique
  clientTimestamp DateTime
  processedAt     DateTime @default(now())
  status          String   @default("completed") // 'pending' | 'completed' | 'failed'
  summary         Json
}

// ─── Research Storage v1: Additive Models ──────────────────────────────────────

// Multi-topic note join table
model NoteTopicLink {
  id      String @id @default(uuid())
  noteId  String
  note    Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@unique([noteId, topicId])
}

// Normalized tag-topic relation (Topic.tags String[] kept as denormalized cache)
model TopicTag {
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([topicId, tagId])
}

// Append-only progress snapshot — never updated, only inserted
model KnowledgeProgressSnapshot {
  id            String   @id @default(uuid())
  topicId       String
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  capturedAt    DateTime @default(now())
  progressData  Json     // immutable copy of StudyProgress at capture time
  triggerReason String?  // 'manual' | 'session_complete' | 'milestone'
}
