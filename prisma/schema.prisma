datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  type        String    // CategoryType — configurable, not hardcoded
  description String?
  parentId    String?
  icon        String?
  color       String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  topics      Topic[]
}

model Tag {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  color     String     @default("#D97706")
  count     Int        @default(0)
  createdAt DateTime   @default(now())
  topicTags TopicTag[] // Research Storage v1: normalized tag relation
}

model Topic {
  id            String          @id @default(uuid())
  title         String
  slug          String          @unique
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  type          String          // CategoryType — configurable, not hardcoded
  parentId      String?
  description   String          @default("")
  content       String          @default("")
  tags          String[]        @default([]) // Kept as denormalized cache for backward compat
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  notes         Note[]
  resources     Resource[]
  studyProgress StudyProgress?
  sourceLinks   KnowledgeLink[] @relation("SourceLinks")
  targetLinks   KnowledgeLink[] @relation("TargetLinks")
  // Research Storage v1: additive relations
  noteLinks     NoteTopicLink[] // multi-topic notes
  topicTags     TopicTag[]      // normalized tag relation
  snapshots     KnowledgeProgressSnapshot[] // append-only progress history
  // Native Flashcard & SRS relations
  flashcards       Flashcard[]
  flashcardReviews FlashcardReview[]
  // NotebookLM Research Hub v2.1 relations
  researchSessions       ResearchSession[]
  groundedArtifacts      GroundedArtifact[]
  researchTimelineEvents ResearchTimelineEvent[]
}

model Note {
  id         String   @id @default(uuid())
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title      String
  content    String
  sourcePath String?  // nullable — matches Note.sourcePath in types/index.ts
  type       String   @default("insight") // 'study' | 'insight' | 'question' | 'summary'
  isPrivate  Boolean  @default(false)
  tags       String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Research Storage v1: additive multi-topic relation
  additionalTopics NoteTopicLink[]
  // Native Flashcard optional relation
  flashcards       Flashcard[]
  // NotebookLM Research Hub v2.1 optional relation
  artifactImports  ArtifactImport[]
}

model Resource {
  id        String   @id @default(uuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title     String
  type      String   @default("book") // 'book' | 'article' | 'video' | 'audio' | 'pdf' | 'link'
  author    String?
  url       String?
  filePath  String?
  notes     String?
  createdAt  DateTime    @default(now())
  // Native Flashcard optional relation
  flashcards Flashcard[]
}

model KnowledgeLink {
  id          String   @id @default(uuid())
  sourceId    String
  source      Topic    @relation("SourceLinks", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId    String
  target      Topic    @relation("TargetLinks", fields: [targetId], references: [id], onDelete: Cascade)
  linkType    String   @default("related") // 'related' | 'prerequisite' | 'advanced' | 'contradicts'
  strength    Int      @default(3)
  notes       String?
  explanation String?
  createdAt   DateTime @default(now())
}

model StudyProgress {
  id          String    @id @default(uuid())
  topicId     String    @unique
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status      String    @default("not_started") // 'not_started' | 'in_progress' | 'completed' | 'reviewing'
  progress    Float     @default(0)
  startDate   DateTime?
  endDate     DateTime?
  lastStudied DateTime?
  nextReview  DateTime?
  interval    Int       @default(0)
  easeFactor  Float     @default(2.5)
  repetitions Int       @default(0)
  totalNotes  Int       @default(0)
  timeSpent   Int       @default(0)
  updatedAt   DateTime  @updatedAt
}

model SyncSession {
  id              String   @id @default(uuid())
  clientSyncId    String   @unique
  clientTimestamp DateTime
  processedAt     DateTime @default(now())
  status          String   @default("completed") // 'pending' | 'completed' | 'failed'
  summary         Json
}

// ─── Research Storage v1: Additive Models ──────────────────────────────────────

// Multi-topic note join table
model NoteTopicLink {
  id      String @id @default(uuid())
  noteId  String
  note    Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@unique([noteId, topicId])
}

// Normalized tag-topic relation (Topic.tags String[] kept as denormalized cache)
model TopicTag {
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([topicId, tagId])
}

// Append-only progress snapshot — never updated, only inserted
model KnowledgeProgressSnapshot {
  id            String   @id @default(uuid())
  topicId       String
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  capturedAt    DateTime @default(now())
  progressData  Json     // immutable copy of StudyProgress at capture time
  triggerReason String?  // 'manual' | 'session_complete' | 'milestone'
}

// ─── Native Flashcard & Spaced Repetition (SM-2) ──────────────────────────────

model Flashcard {
  id              String             @id @default(uuid())
  topicId         String
  topic           Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  noteId          String?
  note            Note?              @relation(fields: [noteId], references: [id], onDelete: SetNull)
  resourceId      String?
  resource        Resource?          @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  type            String             @default("basic") // 'basic' | 'cloze'
  front           String
  back            String
  lifecycleStatus String             @default("active") // 'active' | 'suspended' | 'archived'
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  schedule        FlashcardSchedule?
  reviews         FlashcardReview[]
  // NotebookLM Research Hub v2.1 optional relation
  artifactImports ArtifactImport[]

  @@index([topicId])
  @@index([lifecycleStatus])
}

model FlashcardSchedule {
  id             String    @id @default(uuid())
  flashcardId    String    @unique
  flashcard      Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  state          String    @default("new") // 'new' | 'learning' | 'review' | 'relearning'
  dueAt          DateTime  @default(now())
  interval       Int       @default(0)
  easeFactor     Float     @default(2.5)
  repetitions    Int       @default(0)
  lapses         Int       @default(0)
  lastReviewedAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([dueAt])
}

model FlashcardReview {
  id               String    @id @default(uuid()) // Server-generated PK UUID
  clientEventId    String    @unique             // Option A: Client-generated Idempotency Key
  flashcardId      String
  flashcard        Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  topicId          String
  topic            Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  rating           Int       // 1: Again, 2: Hard, 3: Good, 4: Easy
  reviewDurationMs Int       @default(0)
  reviewedAt       DateTime  @default(now())
  stateBefore      String
  stateAfter       String
  intervalBefore   Int
  intervalAfter    Int
  easeFactorBefore Float
  easeFactorAfter  Float
  dueBeforeAt      DateTime
  dueAfterAt       DateTime

  @@index([flashcardId])
  @@index([topicId])
  @@index([reviewedAt])
}

// ─── NotebookLM Research Hub (v2.1 ADR) Models ───────────────────────────────

model ResearchSession {
  id             String                  @id @default(uuid())
  topicId        String
  topic          Topic                   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status         String                  @default("idle") // 'idle' | 'packaged' | 'prompt_ready' | 'handoff_active' | 'artifact_received' | 'completed' | 'archived'
  notebookUrl    String?
  notebookId     String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  sourcePackages SourcePackage[]
  taskPrompts    TaskPrompt[]
  artifacts      GroundedArtifact[]
  timelineEvents ResearchTimelineEvent[]

  @@index([topicId])
  @@index([status])
}

model SourcePackage {
  id          String             @id @default(uuid())
  sessionId   String
  session     ResearchSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  version     Int                @default(1)
  isCurrent   Boolean            @default(true)
  content     String
  contentHash String
  sourceCount Int                @default(0)
  createdAt   DateTime           @default(now())
  artifacts   GroundedArtifact[]

  @@unique([sessionId, version])
  @@index([sessionId])
  @@index([contentHash])
}

model TaskPrompt {
  id             String             @id @default(uuid())
  sessionId      String
  session        ResearchSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  promptMode     String             @default("study_guide") // 'study_guide' | 'srs_deep_dive' | 'comparative' | 'qa_flashcard' | 'custom'
  promptText     String
  promptHash     String
  version        Int                @default(1)
  isCurrent      Boolean            @default(true)
  cliCommandHint String?
  createdAt      DateTime           @default(now())
  artifacts      GroundedArtifact[]

  @@unique([sessionId, version])
  @@index([sessionId])
  @@index([promptHash])
}

model GroundedArtifact {
  id              String             @id @default(uuid())
  sessionId       String
  session         ResearchSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourcePackageId String?
  sourcePackage   SourcePackage?     @relation(fields: [sourcePackageId], references: [id], onDelete: SetNull)
  taskPromptId    String?
  taskPrompt      TaskPrompt?        @relation(fields: [taskPromptId], references: [id], onDelete: SetNull)
  topicId         String
  topic           Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  artifactType    String             @default("study_guide") // 'study_guide' | 'briefing_doc' | 'qa_pair' | 'raw_markdown'
  title           String
  rawContent      String
  contentHash     String
  idempotencyKey  String             @unique
  status          String             @default("received") // 'received' | 'validated' | 'partially_imported' | 'imported' | 'archived'
  citationCount   Int                @default(0)
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  citations       ArtifactCitation[]
  imports         ArtifactImport[]

  @@index([sessionId])
  @@index([topicId])
  @@index([status])
  @@index([contentHash])
}

model ArtifactCitation {
  id          String           @id @default(uuid())
  artifactId  String
  artifact    GroundedArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  markerIndex Int
  sourceTitle String
  quote       String?
  createdAt   DateTime         @default(now())

  @@index([artifactId])
}

model ArtifactImport {
  id           String           @id @default(uuid())
  artifactId   String
  artifact     GroundedArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  targetType   String           // 'note' | 'flashcards' | 'obsidian'
  targetNoteId String?
  targetNote   Note?            @relation(fields: [targetNoteId], references: [id], onDelete: SetNull)
  targetCardId String?
  targetCard   Flashcard?       @relation(fields: [targetCardId], references: [id], onDelete: SetNull)
  exportPath   String?
  status       String           @default("pending") // 'pending' | 'success' | 'failed'
  itemCount    Int              @default(1)
  error        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([artifactId])
  @@index([targetType])
  @@index([targetNoteId])
  @@index([targetCardId])
}

model ResearchTimelineEvent {
  id        String          @id @default(uuid())
  sessionId String
  session   ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  eventType String          // 'session_created' | 'source_packaged' | 'prompt_generated' | 'handoff_prepared' | 'artifact_received' | 'artifact_reviewed' | 'note_imported' | 'flashcards_generated' | 'obsidian_exported'
  eventData Json?
  createdAt DateTime        @default(now())

  @@index([sessionId])
  @@index([topicId])
  @@index([eventType])
}

