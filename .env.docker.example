# Port mapping for Knowledge OS Web Application on host machine
APP_PORT=3002

# PostgreSQL Database Configuration
POSTGRES_USER=knowledge_os
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_DB=knowledge_os

# AI & Knowledge Integration Secrets (Optional)
GEMINI_API_KEY=
OBSIDIAN_VAULT_ROOT=
OBSIDIAN_VAULTS_CONFIG=

# Destructive Database Reset Protection (ADR-077)
# Bí mật xác nhận bắt buộc truyền qua HTTP Header X-Reset-Confirmation khi gọi POST /api/data/reset
RESET_CONFIRMATION_TOKEN=
# Chỉ bật ALLOW_DATABASE_RESET=true trong môi trường production khi thực sự cần reset có kiểm soát
ALLOW_DATABASE_RESET=false
